{
  "name": "quran-adhan-qibla",
  "version": "0.1.0",
  "description": "Open-source Quran, Adhan, and Qibla app for iOS and Android, built with React Native and Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saad-musbeh/quran-adhan-qibla.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "preview": "expo start --go",
    "android": "npm run rust:android && expo run:android",
    "ios": "npm run rust:ios && expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/domain/coordinates.test.ts",
    "rust:test": "cargo test --workspace --locked",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rust:android": "node scripts/build-native.mjs android",
    "rust:ios": "node scripts/build-native.mjs ios",
    "check": "npm run typecheck && npm test && npm run rust:check && npm run rust:test",
    "export:mobile": "expo export --platform android --platform ios"
  },
  "private": true
}
