{
  "name": "quran-adhan-qibla",
  "version": "0.6.5",
  "description": "Open-source Quran, Adhan, and Qibla app for iOS and Android, built with React Native and Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saad-musbeh/quran-adhan-qibla.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-location": "~57.0.21",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "fzstd": "0.1.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "preview": "expo start --go",
    "android": "npm run rust:android && expo run:android",
    "apk:android": "node scripts/build-android-release.mjs",
    "ios": "npm run rust:ios && expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./src/test-support/native-mocks-register.mjs --test src/domain/*.test.ts src/components/map-assets/*.test.ts src/*.test.ts",
    "test:reader": "node --experimental-strip-types scripts/check-mushaf-renderer.mjs",
    "rust:test": "cargo test --workspace --locked",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rust:android": "node scripts/build-native.mjs android",
    "rust:ios": "node scripts/build-native.mjs ios",
    "test:ios:harness": "node --experimental-strip-types --test scripts/ios-ui-tests.test.mjs",
    "check": "npm run test:security && npm run typecheck && npm run localization:check && npm test && npm run test:ios:harness && npm run rust:check && npm run rust:test",
    "export:mobile": "expo export --platform android --platform ios",
    "postinstall": "node scripts/patch-security-dependencies.mjs && node scripts/patch-expo-audio.mjs",
    "localization:check": "node scripts/localization-audit.mjs",
    "test:security": "node --test scripts/dependency-security.test.mjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
