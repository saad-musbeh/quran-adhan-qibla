{
  "expo": {
    "name": "Quran Adhan Qibla",
    "slug": "quran-adhan-qibla",
    "version": "0.6.1",
    "scheme": "quranadhanqibla",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.saadmusbeh.quranadhanqibla",
      "icon": "./assets/branding/android-icon-v1.png",
      "buildNumber": "24"
    },
    "android": {
      "package": "org.saadmusbeh.quranadhanqibla",
      "versionCode": 24,
      "adaptiveIcon": {
        "backgroundColor": "#1A3D2E",
        "foregroundImage": "./assets/branding/android-icon-v1.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/branding/android-icon-v1.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false,
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك أثناء استخدام التطبيق لحساب اتجاه القبلة ومواقيت الصلاة. Your location is used for Qibla and prayer times while using the app.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-asset",
      "./plugins/withLocalNotificationsOnly.cjs",
      [
        "./plugins/withPlatformNotificationSounds.cjs",
        {
          "sounds": [
            "./assets/adhan/adhan_makkah_clean.ogg",
            "./assets/adhan/adhan_makkah_clean_short.wav",
            "./assets/adhan/adhan_madinah_clean.ogg",
            "./assets/adhan/adhan_madinah_clean_short.wav",
            "./assets/adhan/adhan_andrewler_clean.ogg",
            "./assets/adhan/adhan_andrewler_clean_short.wav",
            "./assets/adhan/adhan_clean.ogg",
            "./assets/adhan/adhan_clean_short.wav",
            "./assets/adhan/adhan_brief.ogg",
            "./assets/adhan/adhan_brief.wav",
            "./assets/adhan/adhan_brief_fajr.ogg",
            "./assets/adhan/adhan_brief_fajr.wav",
            "./assets/adhan/reminder_chime.ogg",
            "./assets/adhan/reminder_chime.wav",
            "./assets/adhan/reminder_salawat_rasul.ogg",
            "./assets/adhan/reminder_salawat_rasul.wav",
            "./assets/adhan/reminder_salawat_sallallahu.ogg",
            "./assets/adhan/reminder_salawat_sallallahu.wav",
            "./assets/adhan/reminder_salawat_prophet.ogg",
            "./assets/adhan/reminder_salawat_prophet.wav",
            "./assets/adhan/reminder_salawat_muhammad.ogg",
            "./assets/adhan/reminder_salawat_muhammad.wav",
            "./assets/adhan/reminder_salawat_english.ogg",
            "./assets/adhan/reminder_salawat_english.wav"
          ],
          "enableBackgroundRemoteNotifications": false,
          "icon": "./assets/branding/notification-icon.png",
          "color": "#D6BA7A"
        }
      ],
      "./plugins/withPrayerExactAlarm.cjs",
      "./plugins/withAndroidReleaseSize.cjs",
      "./plugins/withAndroidTextLayout.cjs"
    ],
    "backgroundColor": "#14293C"
  }
}
