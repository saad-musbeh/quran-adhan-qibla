{
  "expo": {
    "name": "Quran Adhan Qibla",
    "slug": "quran-adhan-qibla",
    "version": "0.3.6",
    "scheme": "quranadhanqibla",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.saadmusbeh.quranadhanqibla",
      "buildNumber": "9"
    },
    "android": {
      "package": "org.saadmusbeh.quranadhanqibla",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#1A3D2E",
        "foregroundImage": "./assets/branding/android-icon-v1.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/branding/android-icon-v1.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "\u0646\u0633\u062a\u062e\u062f\u0645 \u0645\u0648\u0642\u0639\u0643 \u0623\u062b\u0646\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u062d\u0633\u0627\u0628 \u0627\u062a\u062c\u0627\u0647 \u0627\u0644\u0642\u0628\u0644\u0629 \u0648\u0645\u0648\u0627\u0642\u064a\u062a \u0627\u0644\u0635\u0644\u0627\u0629. Your location is used for Qibla and prayer times while using the app.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/adhan/adhan.ogg"
          ],
          "enableBackgroundRemoteNotifications": false,
          "icon": "./assets/branding/notification-icon.png",
          "color": "#D6BA7A"
        }
      ],
      "./plugins/withPrayerExactAlarm.cjs"
    ]
  }
}
